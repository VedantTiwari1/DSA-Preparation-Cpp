#include <string>
#include <algorithm>

using namespace std;

class Solution {
private:
    int getDigitSum(const string &s) {
        int sum = 0;
        for (char c : s) {
            sum += (c - '0');
        }
        return sum;
    }

public:
    int findMax(int n) {
        string s = to_string(n);
        int max_sum = getDigitSum(s);
        int best_num = n;

        int len = s.length();
        for (int i = 0; i < len; ++i) {
            if (s[i] == '0') continue;

            string temp = s;
            temp[i] = temp[i] - 1;
            for (int j = i + 1; j < len; ++j) {
                temp[j] = '9';
            }

            int val = stoi(temp);
            int current_sum = getDigitSum(temp);

            if (current_sum > max_sum || (current_sum == max_sum && val > best_num)) {
                max_sum = current_sum;
                best_num = val;
            }
        }

        return best_num;
    }
};
