class Solution {
public:
    int findKthSmall(vector<int>& arr, int k) {
        int n = arr.size();
        sort(arr.begin(), arr.end());
        
        int low = 0, high = n - 1;
        int ansIndex = n;
        
        while (low <= high) {
            int mid = low + (high - low) / 2;
            int missingBeforeMid = arr[mid] - (mid + 1);
            
            if (missingBeforeMid < k) {
                low = mid + 1;
            } else {
                ansIndex = mid;
                high = mid - 1;
            }
        }
        
        if (ansIndex == 0) {
            return k;
        }
        
        int missingBeforePrev = arr[ansIndex - 1] - ansIndex;
        return arr[ansIndex - 1] + (k - missingBeforePrev);
    }
};
