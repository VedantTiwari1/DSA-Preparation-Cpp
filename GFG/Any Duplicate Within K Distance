class Solution {
  public:
    bool checkWithinK(vector<int>& arr, int k) {
        unordered_set<int> window;
        
        for (int i = 0; i < arr.size(); ++i) {
            // If the element is already in the set, a duplicate exists within distance k
            if (window.find(arr[i]) != window.end()) {
                return true;
            }
            
            // Add the current element to our sliding window set
            window.insert(arr[i]);
            
            // If the window size exceeds k, remove the element falling out of the window
            if (i >= k) {
                window.erase(arr[i - k]);
            }
        }
        
        return false;
    }
};
