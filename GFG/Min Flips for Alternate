class Solution {
  public:
    int minFlips(string &s) {
        int n = s.size();
        int flipsToAlt0 = 0; // mismatches with "010101..."

        for (int i = 0; i < n; i++) {
            char expected0 = (i % 2 == 0) ? '0' : '1';
            if (s[i] != expected0) {
                flipsToAlt0++;
            }
        }

        int flipsToAlt1 = n - flipsToAlt0; // mismatches with "101010..."
        return min(flipsToAlt0, flipsToAlt1);
    }
};
