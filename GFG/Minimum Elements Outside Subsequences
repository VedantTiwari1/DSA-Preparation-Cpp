#include <vector>
#include <algorithm>

using namespace std;

class Solution {
    // Fenwick Tree for Range Max Query (Prefix Max for Increasing Subsequence)
    struct FenwickInc {
        int U;
        vector<int> tree;
        FenwickInc(int u) : U(u), tree(u + 1, 0) {}
        
        void update(int idx, int val) {
            for (; idx <= U; idx += idx & -idx) {
                tree[idx] = max(tree[idx], val);
            }
        }
        
        int query(int idx) {
            int res = 0;
            for (; idx > 0; idx -= idx & -idx) {
                res = max(res, tree[idx]);
            }
            return res;
        }
    };

    // Fenwick Tree for Range Max Query (Suffix Max for Decreasing Subsequence)
    struct FenwickDec {
        int U;
        vector<int> tree;
        FenwickDec(int u) : U(u), tree(u + 1, 0) {}
        
        void update(int idx, int val) {
            for (; idx > 0; idx -= idx & -idx) {
                tree[idx] = max(tree[idx], val);
            }
        }
        
        int query(int idx) {
            int res = 0;
            for (; idx <= U; idx += idx & -idx) {
                res = max(res, tree[idx]);
            }
            return res;
        }
    };

public:
    int minCount(vector<int>& arr) {
        int n = arr.size();
        if (n <= 2) return 0;

        // Coordinate Compression for arr elements
        vector<int> sorted_arr = arr;
        sort(sorted_arr.begin(), sorted_arr.end());
        sorted_arr.erase(unique(sorted_arr.begin(), sorted_arr.end()), sorted_arr.end());
        int U = sorted_arr.size();

        auto get_rank = [&](int val) {
            return lower_bound(sorted_arr.begin(), sorted_arr.end(), val) - sorted_arr.begin() + 1;
        };

        // dp[i][j]: max elements used where I ends at index i and D ends at index j (1-based index)
        vector<vector<int>> dp(n + 1, vector<int>(n + 1, 0));
        
        // Fenwick trees for efficient max query transitions
        vector<FenwickInc> bit_inc(n + 1, FenwickInc(U));
        vector<FenwickDec> bit_dec(n + 1, FenwickDec(U));

        int max_used = 0;

        for (int x = 1; x <= n; ++x) {
            int rk_x = get_rank(arr[x - 1]);

            // Case 1: Place arr[x-1] into Increasing Subsequence (New I end is x)
            for (int j = 0; j < x; ++j) {
                int prev_max = dp[0][j];
                if (rk_x > 1) {
                    prev_max = max(prev_max, bit_inc[j].query(rk_x - 1));
                }
                dp[x][j] = prev_max + 1;
                max_used = max(max_used, dp[x][j]);

                // Update data structures for future transitions
                bit_inc[j].update(rk_x, dp[x][j]);
                if (j > 0) {
                    bit_dec[x].update(get_rank(arr[j - 1]), dp[x][j]);
                }
            }

            // Case 2: Place arr[x-1] into Decreasing Subsequence (New D end is x)
            for (int i = 0; i < x; ++i) {
                int prev_max = dp[i][0];
                if (rk_x < U) {
                    prev_max = max(prev_max, bit_dec[i].query(rk_x + 1));
                }
                dp[i][x] = prev_max + 1;
                max_used = max(max_used, dp[i][x]);

                // Update data structures for future transitions
                bit_dec[i].update(rk_x, dp[i][x]);
                if (i > 0) {
                    bit_inc[x].update(get_rank(arr[i - 1]), dp[i][x]);
                }
            }
        }

        return n - max_used;
    }
};
