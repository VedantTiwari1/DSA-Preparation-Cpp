#include <string>
#include <vector>
#include <algorithm>

using namespace std;

class Solution {
public:
    int findMinCost(string &s1, string &s2, int costS1, int costS2) {
        int m = s1.length();
        int n = s2.length();
        
        // DP table where dp[i][j] stores the LCS length of s1[0...i-1] and s2[0...j-1]
        vector<vector<int>> dp(m + 1, vector<int>(n + 1, 0));
        
        for (int i = 1; i <= m; ++i) {
            for (int j = 1; j <= n; ++j) {
                if (s1[i - 1] == s2[j - 1]) {
                    dp[i][j] = 1 + dp[i - 1][j - 1];
                } else {
                    dp[i][j] = max(dp[i - 1][j], dp[i][j - 1]);
                }
            }
        }
        
        int lcsLength = dp[m][n];
        
        int deleteCountS1 = m - lcsLength;
        int deleteCountS2 = n - lcsLength;
        
        return deleteCountS1 * costS1 + deleteCountS2 * costS2;
    }
};
