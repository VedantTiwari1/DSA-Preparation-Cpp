class Solution {
public:
    int maxTask(vector<int>& h, vector<int>& l) {
        int n = h.size();
        if (n == 0) return 0;
        
        // Base case for the first day
        if (n == 1) return max(h[0], l[0]);
        
        // prev2 represents dp[i-2] (initially before day 0, tasks are 0)
        int prev2 = 0; 
        
        // prev1 represents dp[i-1] (initially the max tasks on day 0)
        int prev1 = max(h[0], l[0]); 
        
        for (int i = 1; i < n; ++i) {
            // Calculate max tasks for the current day
            int current = max(prev1 + l[i], prev2 + h[i]);
            
            // Shift the window for the next iteration
            prev2 = prev1;
            prev1 = current;
        }
        
        return prev1;
    }
};
