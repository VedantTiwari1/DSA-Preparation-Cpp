class Solution {
public:
    int shortestPath(int V, int src, int dest, vector<vector<int>>& edges) {
        // Step 1: Create an adjacency list
        vector<vector<pair<int, int>>> adj(V);
        for (const auto& edge : edges) {
            int u = edge[0];
            int v = edge[1];
            int w = edge[2];
            adj[u].push_back({v, w});
            adj[v].push_back({u, w}); // The graph is undirected
        }

        // Step 2: Initialize distance array with a large value (infinity)
        vector<int> dist(V, 1e9);
        dist[src] = 0;

        // Step 3: Min-heap priority queue to store {distance, vertex}
        priority_queue<pair<int, int>, vector<pair<int, int>>, greater<pair<int, int>>> pq;
        pq.push({0, src});

        // Step 4: Process the graph
        while (!pq.empty()) {
            int current_dist = pq.top().first;
            int u = pq.top().second;
            pq.pop();

            // Early exit if we reach the destination
            if (u == dest) return current_dist;

            // Optimization: skip if we've already found a shorter path to this node
            if (current_dist > dist[u]) continue;

            // Relax adjacent edges
            for (const auto& neighbor : adj[u]) {
                int v = neighbor.first;
                int weight = neighbor.second;

                if (dist[u] + weight < dist[v]) {
                    dist[v] = dist[u] + weight;
                    pq.push({dist[v], v});
                }
            }
        }

        // Step 5: If destination is unreachable
        return dist[dest] == 1e9 ? -1 : dist[dest];
    }
};
