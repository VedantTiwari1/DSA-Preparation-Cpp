class Solution {
public:
    int countAlwaysFound(vector<int>& arr) {
        int n = arr.size();
        if (n == 0) return 0;
        
        vector<int> prefMax(n);
        prefMax[0] = arr[0];
        for (int i = 1; i < n; i++) {
            prefMax[i] = max(prefMax[i - 1], arr[i]);
        }
        
        int count = 0;
        int rightMin = INT_MAX;
        
        // Traverse from right to left to check suffix minimum on the fly
        for (int i = n - 1; i >= 0; i--) {
            if (arr[i] == prefMax[i] && arr[i] <= rightMin) {
                count++;
            }
            rightMin = min(rightMin, arr[i]);
        }
        
        return count;
    }
};
