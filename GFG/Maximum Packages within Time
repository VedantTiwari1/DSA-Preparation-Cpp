class Solution {
public:
    int maxPackages(vector<int>& arr, int totalTime) {
        int n = arr.size();
        
        // If totalTime is greater than or equal to the array size,
        // the agent can visit all locations.
        if (totalTime >= n) {
            int totalSum = 0;
            for (int x : arr) totalSum += x;
            return totalSum;
        }
        
        // Compute the sum of the first window of size `totalTime`
        int currentWindowSum = 0;
        for (int i = 0; i < totalTime; ++i) {
            currentWindowSum += arr[i];
        }
        
        int maxPackagesDelivered = currentWindowSum;
        
        // Slide the window across the rest of the array
        for (int i = totalTime; i < n; ++i) {
            currentWindowSum += arr[i] - arr[i - totalTime];
            maxPackagesDelivered = max(maxPackagesDelivered, currentWindowSum);
        }
        
        return maxPackagesDelivered;
    }
};
