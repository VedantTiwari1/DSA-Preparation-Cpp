#include <vector>
#include <unordered_map>
#include <algorithm>

class Solution {
public:
    int longestSubseq(std::vector<int>& arr) {
        std::unordered_map<int, int> dp;
        int max_len = 0;
        
        for (int num : arr) {
            int len1 = dp.count(num - 1) ? dp[num - 1] : 0;
            int len2 = dp.count(num + 1) ? dp[num + 1] : 0;
            
            dp[num] = 1 + std::max(len1, len2);
            max_len = std::max(max_len, dp[num]);
        }
        
        return max_len;
    }
};
