class Solution {
public:
    string compress(string s) {
        int n = s.length();
        vector<int> lps(n, 0);
        
        // Step 1: Build the LPS (Longest Prefix Suffix) array
        for (int i = 1; i < n; i++) {
            int j = lps[i - 1];
            while (j > 0 && s[i] != s[j]) {
                j = lps[j - 1];
            }
            if (s[i] == s[j]) {
                j++;
            }
            lps[i] = j;
        }
        
        string ans = "";
        int i = n - 1;
        
        // Step 2: Traverse backwards to compress greedily
        while (i >= 0) {
            // If the current prefix length is even, check if we can halve it
            if (i % 2 != 0) {
                int half = (i + 1) / 2;
                int m = lps[i];
                
                // Trace back the LPS chain to find the largest valid prefix-suffix 
                // match that is less than or equal to the half-length
                while (m > half) {
                    m = lps[m - 1];
                }
                
                // If we found a match exactly equal to the half-length, 
                // it means the string is of the form A + A.
                if (m == half) {
                    ans += '*';
                    i = half - 1; // Jump to the end of the first half
                    continue;
                }
            }
            
            // If we couldn't halve it, just append the current character
            ans += s[i];
            i--;
        }
        
        // Step 3: Since we built the result backwards, reverse it at the end
        reverse(ans.begin(), ans.end());
        return ans;
    }
};
