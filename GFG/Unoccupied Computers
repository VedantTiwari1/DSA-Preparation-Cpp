#include <iostream>
#include <string>
#include <vector>

using namespace std;

class Solution {
public:
    int solve(int n, string s) {
        vector<int> status(26, 0); // Tracks state for 'A' through 'Z'
        int occupied = 0;
        int rejectedCount = 0;

        for (char ch : s) {
            int idx = ch - 'A';
            
            if (status[idx] == 0) { // Arrival
                if (occupied < n) {
                    status[idx] = 1; // Assigned computer
                    occupied++;
                } else {
                    status[idx] = 2; // Rejected
                    rejectedCount++;
                }
            } else if (status[idx] == 1) { // Departure of customer with computer
                occupied--;
                status[idx] = 0;
            }
            // If status[idx] == 2 (Departure of rejected customer), do nothing.
        }

        return rejectedCount;
    }
};
