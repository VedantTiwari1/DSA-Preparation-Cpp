class Solution {
public:
    int palindromicStrings(int n, int k) {
        long long total_count = 0;
        long long MOD = 1e9 + 7;
        
        long long current_perm = 1;
        
        for (int L = 1; L <= n; ++L) {
            int m = (L + 1) / 2;
            
            // Impossible to select m distinct characters if m > k
            if (m > k) {
                break;
            }
            
            // m increases only on odd lengths (L = 1, 3, 5, ...)
            if (L % 2 == 1) {
                current_perm = (current_perm * (k - m + 1)) % MOD;
            }
            
            total_count = (total_count + current_perm) % MOD;
        }
        
        return total_count;
    }
};
