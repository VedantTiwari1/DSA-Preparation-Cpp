class Solution {
public:
    int maxValue(int n) {
        // Traverse from the 31st bit down to 0
        for (int i = 31; i >= 2; --i) {
            // Check if the current bit and the two bits below it are all set (1)
            if ((n & (1 << i)) && (n & (1 << (i - 1))) && (n & (1 << (i - 2)))) {
                // Clear the lowest of these three consecutive bits to break the '111' pattern
                n = n ^ (1 << (i - 2));
            }
        }
        return n;
    }
};
