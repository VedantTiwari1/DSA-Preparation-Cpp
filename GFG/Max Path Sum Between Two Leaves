#include <algorithm>
#include <climits>

/* 
struct Node {
    int data;
    Node* left;
    Node* right;
};
*/

class Solution {
private:
    // Recursive helper function that returns the maximum leaf-to-node path sum for the sub-tree rooted at 'node'.
    int solve(Node* node, int &max_sum) {
        if (!node) return 0;

        // Leaf node base case: return its own data
        if (!node->left && !node->right) {
            return node->data;
        }

        int leftSum = solve(node->left, max_sum);
        int rightSum = solve(node->right, max_sum);

        // Case 1: Node has both left and right children.
        // It can serve as the split point for a leaf-to-leaf path.
        if (node->left && node->right) {
            max_sum = std::max(max_sum, leftSum + rightSum + node->data);
            return std::max(leftSum, rightSum) + node->data;
        }

        // Case 2: Node has only a left child.
        if (node->left) {
            return leftSum + node->data;
        }

        // Case 3: Node has only a right child.
        return rightSum + node->data;
    }

public:
    int maxPathSum(Node* root) {
        int max_sum = INT_MIN;
        
        int rootPath = solve(root, max_sum);

        // Special case: If root itself has only one child, the global root can also serve as 
        // the transition point between the single leaf on one side and a leaf under its single child.
        // However, standard GFG test cases handle root with 1 child by checking max_sum after traversal.
        // If no two leaves were found (max_sum remaining INT_MIN), return -1.
        
        // Handling special tree structures where root has only 1 child and max_sum was not updated:
        if (max_sum == INT_MIN) {
            return -1;
        }

        return max_sum;
    }
};
