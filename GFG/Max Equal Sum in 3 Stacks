class Solution {
public:
    int maxEqualSum(vector<int> &s1, vector<int> &s2, vector<int> &s3) {
        int sum1 = 0, sum2 = 0, sum3 = 0;
        
        // Calculate the total sum of each stack
        for (int x : s1) sum1 += x;
        for (int x : s2) sum2 += x;
        for (int x : s3) sum3 += x;
        
        int top1 = 0, top2 = 0, top3 = 0;
        int n1 = s1.size(), n2 = s2.size(), n3 = s3.size();
        
        while (top1 < n1 || top2 < n2 || top3 < n3) {
            // If all sums are equal, return the sum
            if (sum1 == sum2 && sum2 == sum3) {
                return sum1;
            }
            
            // Reduce the stack having the maximum sum
            if (sum1 >= sum2 && sum1 >= sum3 && top1 < n1) {
                sum1 -= s1[top1++];
            } else if (sum2 >= sum1 && sum2 >= sum3 && top2 < n2) {
                sum2 -= s2[top2++];
            } else if (top3 < n3) {
                sum3 -= s3[top3++];
            } else {
                break;
            }
        }
        
        return 0; // If it's not possible to make the sums equal
    }
};
