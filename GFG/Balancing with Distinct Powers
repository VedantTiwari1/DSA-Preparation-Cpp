class Solution {
public:
    bool balancePan(int a, int b) {
        // If a == 2, any integer can be represented in binary
        if (a == 2) return true;
        
        while (b > 0) {
            int rem = b % a;
            if (rem == 0 || rem == 1) {
                b /= a;
            } else if (rem == a - 1) {
                b = b / a + 1;
            } else {
                return false;
            }
        }
        return true;
    }
};
