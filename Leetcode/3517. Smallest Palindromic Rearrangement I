class Solution {
public:
    string smallestPalindrome(string s) {
        vector<int> count(26, 0);
        
        // Step 1: Count character frequencies
        for (char c : s) {
            count[c - 'a']++;
        }

        string half = "";
        string mid = "";

        // Step 2 & 3: Build the first half and find the middle character
        for (int i = 0; i < 26; ++i) {
            if (count[i] % 2 != 0) {
                mid = string(1, i + 'a');
            }
            half += string(count[i] / 2, i + 'a');
        }

        // Step 4: Construct the final string
        string reversed_half = half;
        reverse(reversed_half.begin(), reversed_half.end());

        return half + mid + reversed_half;
    }
};
