#include <vector>
#include <algorithm>

class Solution {
public:
    int firstStableIndex(std::vector<int>& nums, int k) {
        int n = nums.size();
        if (n == 0) return -1;
        
        // Precompute suffix minimums from right to left
        std::vector<int> suffix_min(n);
        suffix_min[n - 1] = nums[n - 1];
        for (int i = n - 2; i >= 0; --i) {
            suffix_min[i] = std::min(nums[i], suffix_min[i + 1]);
        }
        
        int prefix_max = nums[0];
        
        // Find the smallest stable index from left to right
        for (int i = 0; i < n; ++i) {
            prefix_max = std::max(prefix_max, nums[i]);
            
            if (prefix_max - suffix_min[i] <= k) {
                return i;
            }
        }
        
        return -1;
    }
};
