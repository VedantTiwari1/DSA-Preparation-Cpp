class Solution {
public:
    int smallestNumber(int n, int t) {
        // Start checking from n upwards
        while (true) {
            int temp = n;
            int product = 1;
            
            // Calculate the product of the digits
            while (temp > 0) {
                product *= (temp % 10);
                temp /= 10;
            }
            
            // If the product is divisible by t, we found our answer
            if (product % t == 0) {
                return n;
            }
            
            // Otherwise, check the next number
            n++;
        }
    }
};
