class Solution {
private:
    int matchingCount = 0;

    // Helper function returning {sum of subtree, number of nodes in subtree}
    pair<int, int> dfs(TreeNode* root) {
        if (!root) return {0, 0};

        auto [leftSum, leftCount] = dfs(root->left);
        auto [rightSum, rightCount] = dfs(root->right);

        int currentSum = leftSum + rightSum + root->val;
        int currentCount = leftCount + rightCount + 1;

        if (root->val == currentSum / currentCount) {
            matchingCount++;
        }

        return {currentSum, currentCount};
    }

public:
    int averageOfSubtree(TreeNode* root) {
        matchingCount = 0;
        dfs(root);
        return matchingCount;
    }
};
