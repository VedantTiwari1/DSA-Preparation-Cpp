class Solution {
public:
    int climbStairs(int n, vector<int>& costs) {
        // dp[i] stores the minimum cost to reach step i
        vector<long long> dp(n + 1, 1e18);
        dp[0] = 0; // Starting from step 0 with cost = 0
        
        for (int i = 0; i < n; ++i) {
            if (dp[i] == 1e18) continue;
            
            // From step i, you can jump to i + 1, i + 2, or i + 3
            for (int step = 1; step <= 3; ++step) {
                int j = i + step;
                if (j <= n) {
                    long long cost = dp[i] + costs[j - 1] + (long long)(step * step);
                    dp[j] = min(dp[j], cost);
                }
            }
        }
        
        return dp[n];
    }
};
