#include <vector>
#include <string>
#include <algorithm>

using namespace std;

class Solution {
public:
    string stoneGameIII(vector<int>& stoneValue) {
        int n = stoneValue.size();
        // Initialize with a very small number to represent negative infinity
        vector<int> dp(n + 1, -1e9); 
        dp[n] = 0; // Base case: no stones left
        
        for (int i = n - 1; i >= 0; --i) {
            int current_take = 0;
            // The player can take 1, 2, or 3 stones
            for (int k = 0; k < 3 && i + k < n; ++k) {
                current_take += stoneValue[i + k];
                // Maximize the current player's relative score difference
                dp[i] = max(dp[i], current_take - dp[i + k + 1]);
            }
        }
        
        // dp[0] holds Alice's max score difference from the start
        if (dp[0] > 0) {
            return "Alice";
        } else if (dp[0] < 0) {
            return "Bob";
        } else {
            return "Tie";
        }
    }
};
