#include <vector>
#include <string>
#include <queue>
#include <tuple>

using namespace std;

class Solution {
public:
    int minMoves(vector<string>& classroom, int energy) {
        int m = classroom.size();
        int n = classroom[0].size();
        
        int start_r = -1, start_c = -1;
        vector<vector<int>> litter_id(m, vector<int>(n, -1));
        int litter_count = 0;
        
        // Scan the grid for Start position ('S') and Litters ('L')
        for (int r = 0; r < m; ++r) {
            for (int c = 0; c < n; ++c) {
                if (classroom[r][c] == 'S') {
                    start_r = r;
                    start_c = c;
                } else if (classroom[r][c] == 'L') {
                    litter_id[r][c] = litter_count++;
                }
            }
        }
        
        // If there is no litter to collect, 0 moves needed
        if (litter_count == 0) return 0;
        
        int target_mask = (1 << litter_count) - 1;
        
        // max_energy[r][c][mask] stores max energy left at (r, c) with collected mask
        vector<vector<vector<int>>> max_energy(
            m, vector<vector<int>>(n, vector<int>(1 << litter_count, -1))
        );
        
        // BFS Queue stores: {row, col, mask, current_energy}
        queue<tuple<int, int, int, int>> q;
        
        q.push({start_r, start_c, 0, energy});
        max_energy[start_r][start_c][0] = energy;
        
        int moves = 0;
        int dr[] = {-1, 1, 0, 0};
        int dc[] = {0, 0, -1, 1};
        
        while (!q.empty()) {
            int sz = q.size();
            while (sz--) {
                auto [r, c, mask, curr_energy] = q.front();
                q.pop();
                
                for (int i = 0; i < 4; ++i) {
                    int nr = r + dr[i];
                    int nc = c + dc[i];
                    
                    // Check grid bounds and obstacles
                    if (nr >= 0 && nr < m && nc >= 0 && nc < n && classroom[nr][nc] != 'X') {
                        int next_energy = curr_energy - 1;
                        if (next_energy < 0) continue; // Out of energy
                        
                        int next_mask = mask;
                        
                        if (classroom[nr][nc] == 'R') {
                            next_energy = energy; // Restore energy to full capacity
                        } else if (classroom[nr][nc] == 'L') {
                            next_mask |= (1 << litter_id[nr][nc]);
                        }
                        
                        // Check if all litter has been collected
                        if (next_mask == target_mask) {
                            return moves + 1;
                        }
                        
                        // Push to queue only if we reach this state with strictly higher energy
                        if (next_energy > max_energy[nr][nc][next_mask]) {
                            max_energy[nr][nc][next_mask] = next_energy;
                            q.push({nr, nc, next_mask, next_energy});
                        }
                    }
                }
            }
            moves++;
        }
        
        return -1; // Unreachable to collect all litters
    }
};
