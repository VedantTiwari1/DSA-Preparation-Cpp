class Solution {
public:
    bool stoneGame(vector<int>& piles) {
        int n = piles.size();
        // dp[i][j] stores the max score difference for piles[i...j]
        vector<vector<int>> dp(n, vector<int>(n, 0));

        // Base case: When there is only one pile, the player just takes it
        for (int i = 0; i < n; i++) {
            dp[i][i] = piles[i];
        }

        // Loop over the length of the subarray
        for (int len = 2; len <= n; len++) {
            for (int i = 0; i <= n - len; i++) {
                int j = i + len - 1;
                // Choose the option that leaves the opponent with a worse outcome
                dp[i][j] = max(piles[i] - dp[i + 1][j], piles[j] - dp[i][j - 1]);
            }
        }

        // If the max score difference from the whole array is > 0, Alice wins
        return dp[0][n - 1] > 0;
    }
};
